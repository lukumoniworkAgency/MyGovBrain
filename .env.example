NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-side only. Never expose to the browser.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the Gemini model (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Optional: Upstash Redis (REST) for distributed AI rate limiting.
# Without these, an in-memory limiter is used (single instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
